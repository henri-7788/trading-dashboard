# App
APP_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt exchange API keys/secrets before they're stored in Appwrite. Losing this key
# makes every stored exchange connection unusable — back it up somewhere safe.
ENCRYPTION_KEY=

# Appwrite (self-hosted)
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=trading_dashboard
APPWRITE_TRADES_COLLECTION_ID=trades
APPWRITE_SYNC_STATE_COLLECTION_ID=sync_state
APPWRITE_CONNECTIONS_COLLECTION_ID=connections
APPWRITE_HOLDINGS_COLLECTION_ID=holdings
APPWRITE_TRANSACTIONS_COLLECTION_ID=transactions

# Hyperliquid wallet, exchange API keys, and manual stock/ETF positions are no longer configured
# via env vars — add them under Einstellungen in the running app instead.
